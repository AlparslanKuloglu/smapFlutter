{
  // SMAP run configurations. Debug-only defines (SHELL_PREVIEW, THEME_MODE,
  // SCAN_GALLERY) do nothing in release builds. See docs/DEVELOPING.md.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SMAP",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "SMAP (config/dev.json)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "SMAP · öğrenci önizlemesi (hesapsız)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=SHELL_PREVIEW=student"]
    },
    {
      "name": "SMAP · koç önizlemesi (hesapsız)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=SHELL_PREVIEW=coach"]
    },
    {
      "name": "SMAP · koyu tema",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=THEME_MODE=dark"]
    },
    {
      "name": "SMAP · okutma galeriden (simülatör)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=SCAN_GALLERY=true"]
    },
    {
      "name": "Bileşen galerisi",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_gallery.dart"
    },
    {
      "name": "SMAP (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "SMAP (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ]
}
