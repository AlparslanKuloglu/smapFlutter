{
  // SMAP tasks; the same commands as CI (.github/workflows/ci.yml).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codegen: build_runner",
      "type": "shell",
      "command": "dart run build_runner build -d",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Codegen: build_runner watch",
      "type": "shell",
      "command": "dart run build_runner watch -d",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "l10n: merge ARB + gen-l10n",
      "type": "shell",
      "command": "dart run tool/merge_arb.dart && flutter gen-l10n",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Check: format + analyze + UI rules",
      "type": "shell",
      "command": "dart format lib test tool && flutter analyze && tool/ui_rules.sh",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "flutter test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Unreachable files",
      "type": "shell",
      "command": "dart run tool/unreachable_files.dart",
      "problemMatcher": []
    },
    {
      "label": "iOS: pod install",
      "type": "shell",
      "command": "cd ios && pod install",
      "problemMatcher": []
    },
    {
      "label": "Brand: launcher icons + splash",
      "type": "shell",
      "command": "dart run flutter_launcher_icons && dart run flutter_native_splash:create",
      "problemMatcher": []
    },
    {
      "label": "Flutter clean",
      "type": "shell",
      "command": "flutter clean && flutter pub get",
      "problemMatcher": []
    }
  ]
}
