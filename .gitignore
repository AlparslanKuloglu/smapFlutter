**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local run config (copy config/dev.json.example)
config/dev.json

# Credentials and signing material never go into git (the owner keeps them).
google-services*.json
GoogleService-Info.plist
.env
.env.*
*.p8
*.p12
*.jks
*.keystore
key.properties
*adminsdk*.json

# Test coverage and local agent/editor state
coverage/
.claude/
